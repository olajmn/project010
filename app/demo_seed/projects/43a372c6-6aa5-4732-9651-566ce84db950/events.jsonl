{"id": 43, "project_id": "43a372c6-6aa5-4732-9651-566ce84db950", "user_id": 1, "created_at": "2026-10-14T13:37:48.000+00:00", "event": "chat", "sent_at": "2026-10-14T13:37:36.000+00:00", "map_focus": "Surroundings", "focus_node_id": "d396b4cb-c483-4462-b752-87792d2fd197", "message": "Whats this", "reply": "Surroundings is a part under Concept that focuses on the external environment of the site, including nearby buildings, infrastructure, and landscape features. It helps understand how the project fits into its existing context before detailed design begins.", "name": "Building Project", "account_id": "c570fe64-4d1e-4539-af6e-58e0f71d5c63", "cancelled": false}
